<Wizard>
	<Global>
		<CustomScript>DeployWiz_SelectOS.vbs</CustomScript>
	</Global>
	<Pane id="SelectOperatingSystem" title="Operating System">
		<Condition><![CDATA[UCase(Property("OSValue"))=""]]></Condition>
		<Body>
			<![CDATA[
				<H1>Select an operating system to install on this computer.</H1>
				<div class=TreeList id=OSListBox style="height: expression( GetDynamicListBoxSize(this) );">
<label class=errmsg style="display: inline;" >No operating systems are available (OperatingSystems.xml does not exist, is empty, or is inaccessible)</label>
					<!-- List goes here -->
				</div>
			]]>
		</Body>
		<Initialization><![CDATA[InitializeOSList]]></Initialization>
		<Validation><![CDATA[ValidateOSList]]></Validation>
	</Pane>
</Wizard>
